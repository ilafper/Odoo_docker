<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='liga_partido_action' model='ir.actions.act_window'>
        <field name="name">Partidos de la liga</field>
        <field name="res_model">liga.partido</field>
        <field name="view_mode">kanban,list,form,graph</field>
    </record>

    <menuitem name="Partidos de la liga" id="liga_partido_menu" parent="liga_base_menu" action="liga_partido_action" />

    <menuitem name="Partidos de la liga" id="liga_partido_menu" parent="liga_base_menu" action="liga_partido_action" />

    <!-- VISTA DE FORMULARIO -->
    <record id="liga_partido_view_form" model="ir.ui.view">
        <field name="name">Formulario Partidos</field>
        <field name="model">liga.partido</field>
        <field name="arch" type="xml">
            <form>
                 <!-- boton para imprmir el pdf del partido -->
                <header>
                        <button
                            name="%(EJ07-LigaFutbol.boton_imprimir_pdf)d"
                            string="Imprimir Informe"
                            type="action"
                            class="btn-primary"/>
                        
                </header>
                
                
                <sheet>
                    <group>
                        <group>
                            <field name="equipo_casa" />
                            <field name="goles_casa" />
                        </group>

                        <group>
                            <field name="equipo_fuera" />
                            <field name="goles_fuera" />
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista LISTA -->
    <record id="liga_partido_view_list" model="ir.ui.view">
        <field name="name">Lista de partidos de la liga</field>
        <field name="model">liga.partido</field>
        <field name="arch" type="xml">
            <list>
                <!-- botones de sumar goles en local y visitante en la vista de lista , 
                    el always es importante añadirlo por que si no no te apareceran los botones
                 -->
                <header>
                        <button
                            name="sumar_2_goles_local"
                            string="+2 goles local"
                            type="object"
                            display="always"
                            confirm="¿Desea sumar 2 goles a los equipos locales?"/>
                        
                        <button
                            name="sumar_2_goles_visitante"
                            string="+2 goles visitante"
                            type="object"
                            display="always"
                            confirm="¿Desea sumar 2 goles a los equipos visitantes?"/>
                </header>
                
                <!-- Campos -->
                <field name="equipo_casa" />
                <field name="goles_casa" />
                <field name="equipo_fuera" />
                <field name="goles_fuera" />
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="liga_partido_view_kanban" model="ir.ui.view">
        <field name="name">Kanban Partidos</field>
        <field name="model">liga.partido</field>
        <field name="arch" type="xml">
            <kanban>
                <!-- botones de sumar goles en local y visitante en la vista de kanvan -->
                <header>

                        <button
                            name="sumar_2_goles_local"
                            string="+2 goles local"
                            type="object"
                            display="always"
                            confirm="¿Desea sumar 2 goles a los equipos locales?"
                            class="oe_highlight"/>
                        
                        <button
                            name="sumar_2_goles_visitante"
                            string="+2 goles visitante"
                            type="object"
                            display="always"
                            confirm="¿Desea sumar 2 goles a los equipos visitantes?"
                            class="oe_highlight"/>
                            
                </header>

                <!-- Campos -->
                <field name="equipo_casa" />
                <field name="goles_casa" />
                <field name="equipo_fuera" />
                <field name="goles_fuera" />

                <!-- Plantilla -->
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card">
                                    <div class="text-muted">
                                        <b><p>- Resultado -</p></b>
                                    </div>
                                    <div>
                                        <field name="equipo_casa" /> : <field name="goles_casa" />
                                    </div>
                                </div>
                                <div>
                                    <field name="equipo_fuera" /> : <field name="goles_fuera" />
                                </div>
                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
     

    <record model="ir.ui.view" id="liga_partido_view_graph">
        <!-- este es un id inerno para la vista de grafg en la base de datos no es visible para el usuario en la interfaz --> 
        <field name="name">vista grafica goles locales total</field>
        <!-- modelo  al que hace referencia-->
        <field name="model">liga.partido</field>
        <!--  tipo -->
        <field name="type">graph</field>
        <field name="arch" type="xml">  
                
            <graph string="Goles locales todos">
                <field name="equipo_casa" group="True" type="row"/>
            <!--   el type mesure hace calculos del campo que le mandas por defecto hace una suma que lo que buscamos en este ejecercicio-->
                <field name="goles_casa" group="True" type="measure" string="Total_goles_local"/>
             </graph>
        </field>
     </record>

</odoo>